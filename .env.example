# ─── Database ────────────────────────────────────────────────────────────────
# Local: `npm run db:dev` starts Postgres on port 51214 (no Docker needed).
# Production (Supabase): DATABASE_URL = transaction pooler (port 6543),
#                        DIRECT_URL   = session/direct connection (port 5432), used by migrations.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
DIRECT_URL=""
# `prisma dev` is single-connection (PGlite): serialize queries locally. Omit in production (default 5).
DATABASE_POOL_MAX="1"
# Separate database for integration/E2E tests (they truncate tables).
DATABASE_URL_TEST="postgres://postgres:postgres@localhost:51219/template1?sslmode=disable"

# ─── Auth (Better Auth) ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated list of emails allowed to sign in (GitHub OAuth). Empty = only seeded users.
ALLOWED_EMAILS=""
# Optional GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Demo user created by `npm run db:seed`
DEMO_EMAIL="demo@orderhub.dev"
DEMO_PASSWORD="change-me-demo-123"

# ─── Stores (Shopify) ────────────────────────────────────────────────────────
# Stores and their webhook secrets are managed in the app (/stores), not here.
# 32-byte key (base64) that encrypts each store's webhook secret at rest (AES-256-GCM):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STORE_SECRETS_KEY=""
# Local development only: `npm run db:seed` registers a local Shopify store with this domain and
# secret, and `npm run webhook:send` signs with them. Not read by the app.
LOCAL_SHOP_DOMAIN="order-hub-dev.myshopify.com"
LOCAL_WEBHOOK_SECRET="local_webhook_secret"

# ─── AI agent (Anthropic) ────────────────────────────────────────────────────
# Bring your own key: every user saves their own Anthropic key on the /agent page.
# Optional operator key, used ONLY by the emails in AGENT_OWNER_EMAILS (never by other users).
ANTHROPIC_API_KEY=""
AGENT_OWNER_EMAILS=""
ANTHROPIC_MODEL="claude-opus-5-5"
# Max agent questions per user per day (cost guard)
AGENT_DAILY_LIMIT="20"

# ─── CRM rules ───────────────────────────────────────────────────────────────
# Days without a purchase after which a customer becomes "em_risco"
CRM_RISK_DAYS="60"
