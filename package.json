{
  "name": "order-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Shopify → CRM: webhooks de pedidos, métricas de clientes (LTV, ticket médio, segmentos) e agente de IA de retenção.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "db:dev": "prisma dev --name order-hub --detach",
    "db:test:start": "prisma dev --name order-hub-test --detach",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:studio": "prisma studio",
    "webhook:send": "tsx scripts/send-test-webhook.ts",
    "postinstall": "prisma generate",
    "check": "npm run lint && npm run typecheck && npm run test && npm run docs:check",
    "vercel-build": "prisma migrate deploy && next build",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.18",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fsemilia/order-hub"
  },
  "author": "Filippo Semilia"
}
