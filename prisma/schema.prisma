// Order Hub — data model
// Conventions:
//   * Money is always Decimal(12,2), never Float.
//   * Shopify IDs are stored as String (they exceed JS safe integers in some resources).
//   * Multi-store: every domain row belongs to a Store; Shopify IDs are unique per store.
//   * Customer aggregates (ordersCount, totalSpent, first/lastOrderAt) are denormalized and
//     recomputed inside the same transaction that writes an order: see lib/crm/aggregates.ts.
//   * The segment (novo / recorrente / em_risco) is NOT stored: it depends on "now",
//     so it is derived at query time from lastOrderAt (lib/crm/segments.ts).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Domain ─────────────────────────────────────────────────────────────────

enum StoreKind {
  DEMO
  SHOPIFY
}

// A workspace: either the seeded demo store or a real Shopify store sending webhooks.
model Store {
  id               String    @id @default(cuid())
  name             String
  kind             StoreKind @default(SHOPIFY)
  // e.g. "sitoweb1.myshopify.com"; null for the demo store
  shopDomain       String?   @unique
  // Shop currency (Shopify order totals are in the shop currency)
  currency         String    @default("BRL") @db.Char(3)
  // Webhook signing secret, AES-256-GCM encrypted with STORE_SECRETS_KEY (lib/crypto.ts)
  webhookSecretEnc String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customers     Customer[]
  orders        Order[]
  checkouts     Checkout[]
  webhookEvents WebhookEvent[]
  agentRuns     AgentRun[]

  @@map("stores")
}

model Customer {
  id               String    @id @default(cuid())
  storeId          String
  store            Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shopifyId        String
  email            String?
  firstName        String?
  lastName         String?
  phone            String?
  acceptsMarketing Boolean   @default(false)
  // LGPD: set when Shopify sends customers/redact; PII fields are wiped.
  redactedAt       DateTime?

  // Denormalized aggregates over paid, non-cancelled orders
  ordersCount  Int       @default(0)
  totalSpent   Decimal   @default(0) @db.Decimal(12, 2)
  firstOrderAt DateTime?
  lastOrderAt  DateTime?

  orders    Order[]
  checkouts Checkout[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([storeId, shopifyId])
  @@index([storeId, lastOrderAt])
  @@index([storeId, totalSpent])
  @@map("customers")
}

model Order {
  id                String    @id @default(cuid())
  storeId           String
  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shopifyId         String
  // Human-readable order name, e.g. "#1001"
  name              String
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // current_total_price from Shopify: already reflects refunds and order edits
  totalPrice        Decimal   @db.Decimal(12, 2)
  currency          String    @db.Char(3)
  financialStatus   String
  fulfillmentStatus String?
  placedAt          DateTime
  cancelledAt       DateTime?
  // updated_at from Shopify: used to drop out-of-order (stale) webhooks
  shopifyUpdatedAt  DateTime

  lineItems OrderLineItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([storeId, shopifyId])
  @@index([customerId, placedAt])
  @@index([storeId, placedAt])
  @@map("orders")
}

model OrderLineItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyId String
  title     String
  sku       String?
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)

  @@unique([orderId, shopifyId])
  @@index([title])
  @@map("order_line_items")
}

// Idempotency log: Shopify delivers at-least-once. X-Shopify-Webhook-Id is the primary key,
// so a duplicate delivery fails with P2002 inside the transaction and is acknowledged with 200.
model WebhookEvent {
  id         String   @id
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  topic      String
  shopDomain String?
  receivedAt DateTime @default(now())

  @@index([storeId, receivedAt])
  @@map("webhook_events")
}

// Shopify checkouts (checkouts/create, checkouts/update). Not completed = abandoned cart.
model Checkout {
  id                   String    @id @default(cuid())
  storeId              String
  store                Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shopifyId            String
  customerId           String?
  customer             Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email                String?
  totalPrice           Decimal   @db.Decimal(12, 2)
  currency             String    @db.Char(3)
  itemsCount           Int
  items                Json
  abandonedCheckoutUrl String?
  startedAt            DateTime
  completedAt          DateTime?
  shopifyUpdatedAt     DateTime
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([storeId, shopifyId])
  @@index([storeId, completedAt, startedAt])
  @@map("checkouts")
}

// Audit + cost tracking for the AI agent (also used for the per-user daily limit).
model AgentRun {
  id           String   @id @default(cuid())
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question     String
  answer       String?
  toolCalls    Json?
  inputTokens  Int?
  outputTokens Int?
  durationMs   Int?
  error        String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("agent_runs")
}

// ─── Auth (Better Auth core schema) ─────────────────────────────────────────

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  agentRuns     AgentRun[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
